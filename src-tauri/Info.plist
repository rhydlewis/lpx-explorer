<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sparkle auto-updater (lpx-explorer-tat).
         SUFeedURL points at the appcast.xml the release pipeline will
         publish to GitHub Releases (lpx-explorer-z7j wires the actual
         publish step). The placeholder URL stays in place until the
         first signed release lands.
         SUPublicEDKey is the EdDSA public half of the keypair stored in
         Keychain on the build machine (private key under
         account=ed25519 in the user's login keychain — generated by
         sparkle-bin/generate_keys, shared with flowcus-v2). -->
    <key>SUFeedURL</key>
    <string>https://github.com/rhydlewis/lpx-explorer/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>K3ez3NH5DW5mbJbJcMWK5yvK5JYv7gjMowuMZsJwzf0=</string>
    <!-- Update check schedule: at launch + every 24h. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
