#!/usr/bin/env sh
# Regenerate .beads/issues.jsonl and sync it before every push.
# Lives here rather than .git/hooks because husky owns core.hooksPath.
#
# Prints on every push so a silent hook can never be mistaken for a
# working one — that ambiguity is what let the sync die unnoticed in June.

if command -v bd >/dev/null 2>&1; then
  echo "beads: pre-push sync starting..."
  export BD_GIT_HOOK=1

  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
    if [ $_bd_exit -eq 124 ]; then
      echo >&2 "beads: timed out after ${_bd_timeout}s — push continuing without sync"
      _bd_exit=0
    fi
  else
    bd hooks run pre-push "$@"
    _bd_exit=$?
  fi

  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialised — nothing to sync"
    _bd_exit=0
  fi

  echo "beads: pre-push sync finished (exit $_bd_exit)"
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
else
  echo >&2 "beads: 'bd' not found on PATH — issues.jsonl NOT synced"
fi
